---
/**
 * Renders the catalog filter controls and applies their selections to the
 * statically rendered game cards.
 */
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/70 p-5" data-testid="game-filters">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by category</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-400 hover:text-slate-100 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                        <input
                            type="checkbox"
                            value={category.id}
                            data-filter-category={category.id}
                            data-testid={`category-filter-${category.id}`}
                            class="h-4 w-4 accent-blue-500"
                        />
                        <span>{category.name}</span>
                    </label>
                ))}
            </div>
        </fieldset>

        <div class="flex flex-col gap-2">
            <label for="publisher-filter" class="text-sm font-semibold text-slate-100">Filter by publisher</label>
            <select
                id="publisher-filter"
                data-filter-publisher
                data-testid="publisher-filter"
                class="min-w-56 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
        </div>

        <button
            type="reset"
            data-testid="clear-filters"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:border-blue-400 hover:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
            Clear filters
        </button>
    </div>
    <p class="mt-4 text-sm text-slate-400" data-filter-count data-testid="game-filter-count" aria-live="polite"></p>
</form>

<script>
    const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const filterCount = filterForm?.querySelector<HTMLElement>('[data-filter-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

    const updateFilters = (): void => {
        if (!filterForm) return;

        const selectedCategories = new Set(
            Array.from(filterForm.querySelectorAll<HTMLInputElement>('[data-filter-category]:checked'))
                .map((input) => input.value),
        );
        const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('[data-filter-publisher]')?.value ?? '';
        let visibleCount = 0;

        for (const card of gameCards) {
            const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategory ?? '');
            const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisher;
            const isVisible = categoryMatches && publisherMatches;
            card.hidden = !isVisible;
            if (isVisible) visibleCount += 1;
        }

        if (filterCount) {
            filterCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
        }
        if (emptyState) emptyState.hidden = visibleCount !== 0;
    };

    filterForm?.addEventListener('change', updateFilters);
    filterForm?.addEventListener('reset', () => requestAnimationFrame(updateFilters));
    updateFilters();
</script>